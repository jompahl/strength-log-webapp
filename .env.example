GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_SA_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_ID=your-google-sheet-id

# Optional: enables personal OpenRouter keys after applying supabase/server-openrouter.sql.
# Use the sb_secret_ key from the same Supabase project. Server runtime only.
SUPABASE_SECRET_KEY=
SESSION_SECRET=generate-a-long-random-secret-for-seven-day-login-sessions
ANTHROPIC_API_KEY=sk-ant-your-key
# Secret used to encrypt each user's own OpenRouter key at rest (generate a long random string).
AI_KEY_ENCRYPTION_KEY=generate-a-long-random-secret
# Optional attribution shown on your OpenRouter dashboard for bring-your-own-key requests.
OPENROUTER_APP_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=Strength Log
OURA_CLIENT_ID=your-oura-oauth-client-id
OURA_CLIENT_SECRET=your-oura-oauth-client-secret
OURA_REDIRECT_URI=https://your-app.vercel.app/api/oura
OURA_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
WITHINGS_CLIENT_ID=your-withings-oauth-client-id
WITHINGS_CLIENT_SECRET=your-withings-oauth-client-secret
WITHINGS_REDIRECT_URI=https://your-app.vercel.app/api/withings
WITHINGS_TOKEN_ENCRYPTION_KEY=generate-a-separate-long-random-secret
WITHINGS_WEBHOOK_URI=https://your-app.vercel.app/api/withings-webhook
WITHINGS_WEBHOOK_SECRET=generate-another-long-random-secret
